FROM oven/bun:1.3.14-debian AS manifests

WORKDIR /app

COPY package.json bun.lock tsconfig.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/agent-gateway/package.json ./apps/agent-gateway/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY modules/nano-brain/package.json ./modules/nano-brain/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/config/package.json ./packages/config/package.json
COPY packages/gateway/package.json ./packages/gateway/package.json
COPY packages/identity/package.json ./packages/identity/package.json
COPY packages/minimax/package.json ./packages/minimax/package.json
COPY packages/platform/package.json ./packages/platform/package.json

FROM manifests AS api-dependencies

RUN bun install --frozen-lockfile --production --filter @mcb/api

FROM manifests AS agent-gateway-dependencies

RUN bun install --frozen-lockfile --production --filter @mcb/agent-gateway

FROM manifests AS nano-brain-dependencies

RUN bun install --frozen-lockfile --production --filter @mcb/nano-brain

FROM oven/bun:1.3.14-debian AS api

WORKDIR /app
ENV NODE_ENV=production

COPY --from=api-dependencies /app/node_modules ./node_modules
COPY --from=manifests /app/package.json ./package.json
COPY apps/api ./apps/api
COPY --from=api-dependencies /app/apps/api/node_modules ./apps/api/node_modules
COPY packages/contracts ./packages/contracts
COPY packages/gateway ./packages/gateway
COPY --from=api-dependencies /app/packages/gateway/node_modules ./packages/gateway/node_modules
COPY packages/identity ./packages/identity
COPY --from=api-dependencies /app/packages/identity/node_modules ./packages/identity/node_modules
COPY packages/platform ./packages/platform
COPY --from=api-dependencies /app/packages/platform/node_modules ./packages/platform/node_modules

EXPOSE 3101
CMD ["sh", "-c", "exec bun run --cwd /app/apps/api start"]

FROM agent-gateway-dependencies AS agent-gateway-build

COPY apps/agent-gateway/src ./apps/agent-gateway/src
COPY packages/contracts ./packages/contracts
COPY packages/gateway ./packages/gateway
COPY packages/identity ./packages/identity
COPY packages/minimax ./packages/minimax
COPY packages/platform ./packages/platform

RUN bun build --target=bun --production --outdir /out apps/agent-gateway/src/http/server.ts
RUN bun build --target=bun --production --outdir /out apps/agent-gateway/src/verification/module-tool-probe.ts

FROM oven/bun:1.3.14-debian AS agent-gateway

WORKDIR /app
ENV NODE_ENV=production

COPY --from=agent-gateway-build /out/ ./

EXPOSE 3002
CMD ["bun", "server.js"]

FROM oven/bun:1.3.14-debian AS nano-brain

WORKDIR /app
ENV NODE_ENV=production

COPY --from=nano-brain-dependencies /app/node_modules ./node_modules
COPY --from=manifests /app/package.json ./package.json
COPY modules/nano-brain ./modules/nano-brain
COPY --from=nano-brain-dependencies /app/modules/nano-brain/node_modules ./modules/nano-brain/node_modules
COPY packages/contracts ./packages/contracts
COPY packages/identity ./packages/identity
COPY --from=nano-brain-dependencies /app/packages/identity/node_modules ./packages/identity/node_modules

EXPOSE 8100
CMD ["sh", "-c", "exec bun run --cwd /app/modules/nano-brain http"]
